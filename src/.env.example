# AI Security Shield — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# ─── IBM watsonx.ai (optional) ───────────────────────────────────────────────
# If not set, the application uses the built-in AI fallback summary generator.
# The demo works fully without these keys.
VITE_BOB_API_KEY=
VITE_BOB_PROJECT_ID=
VITE_BOB_URL=https://us-south.ml.cloud.ibm.com

# ─── App ─────────────────────────────────────────────────────────────────────
VITE_APP_ENV=development
